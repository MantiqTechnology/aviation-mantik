DEMO_MODE=true
DEMO_SESSION_SECRET=ini_adalah_rahasia_super_panjang_sekali_minimal_32_karakter_ya_1234567890
# Neon PostgreSQL tooling. Runtime/Vercel cutover is not yet enabled; migrations
# use the direct (unpooled) endpoint and health checks use the pooled endpoint.
DATABASE_URL=postgresql://<user>:<password>@<project>-pooler.<region>.aws.neon.tech/neondb?sslmode=verify-full
DATABASE_URL_UNPOOLED=postgresql://<user>:<password>@<project>.<region>.aws.neon.tech/neondb?sslmode=verify-full
# Current application runtime still uses SQLite.
MANTIK_DB_PATH=./data/mantik-demo.sqlite
MANTIK_UPLOAD_DIR=./data/uploads/mantik-local
MANTIK_UPLOAD_MANIFEST=./data/mantik-local-uploads.json
MANTIK_DOCUMENT_MANIFEST=./data/mantik-local-documents.json

# --- Uploads via S3 API ---
S3_UPLOAD_BUCKET=mantik-demo-document
S3_UPLOAD_ENDPOINT=https://636486e7d8a364701b53fba192ad7e3b.r2.cloudflarestorage.com
S3_UPLOAD_REGION=auto
S3_UPLOAD_MANIFEST_KEY=_manifests/mantik-uploads.json
S3_UPLOAD_ACCESS_KEY_ID=
S3_UPLOAD_SECRET_ACCESS_KEY=
# Leave empty for private buckets; uploads will be served through /api/uploads/:id/file.
S3_UPLOAD_PUBLIC_BASE_URL=

# --- Public image access ---
# Leave as the app proxy for private R2 buckets, or set to a public bucket root/custom domain.
AIRCRAFT_IMAGE_BASE_URL=/api/aircraft-images
